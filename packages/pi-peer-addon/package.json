{
    "name": "@gaosh3n/pi-peer-addon",
    "version": "0.1.2",
    "description": "An add-on built on top of Pi extension pi-peer",
    "type": "module",
    "packageManager": "pnpm@11.23.0",
    "keywords": [
        "pi",
        "extension",
        "pi-peer",
        "add-on"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
