{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": ["packages/**/*.ts"],
    "exclude": ["node_modules", "dist", "coverage"]
}
